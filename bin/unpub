#!/usr/bin/env fish
# -*- mode: fish -*-

set -l args $argv
set -l root (path resolve (status filename)/../..)
argparse -us vendor=\& -- $argv
set -q _flag_vendor_value; and set -l vendor $_flag_vendor_value; or set -l vendor ~/.local/share/fish
# set -s root vendor >&2


for a in $argv
    for f in (path filter -f $vendor/vendor_*/$a.fish)
        set -l src (string replace -r "^$vendor" "$root" $f)
        # set -s f src >&2
        # set -l fish_trace 1
        # FUTURE mcarifio: backup?
        [ "$(path resolve $f)" = "$src" ]; and unlink $f 
    end
end
