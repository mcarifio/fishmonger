#!/usr/bin/env fish
# -*- mode: fish -*-

set -l args $argv
set -l root (path resolve (status filename)/../..)
argparse -us vendor=\& -- $argv
set -q _flag_vendor_value; and set -l vendor $_flag_vendor_value; or set -l vendor ~/.local/share/fish
# set -s root vendor >&2


for a in $argv
    for f in (path filter -f $root/vendor_*/$a.fish)
        set -l target (string replace -r "^$root" "$vendor" $f)
        # set -s f target >&2
        # set -l fish_trace 1
        # FUTURE mcarifio: backup?
        link $f $target
    end
end
