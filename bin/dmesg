#!/usr/bin/env -S sudo fish
# -*- mode: fish -*-
# FUTURE mcarifio: security sandbox?
set -p fish_function_path (path resolve (status filename)/../../..)/fish/vendor_functions.d
set -l args $argv

argparse -us err\& -- $argv; or return
set -q _flag_err; and set -l level '--level=err,emerg,crit'

# set -l fish_trace 1
_cmd=(forward (status filename)) $_cmd --color=always $level $argv | less -R

