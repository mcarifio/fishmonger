#!/usr/bin/env -S sudo fish
set -q SUDO_USER; set -al fish_function_path ~$SUDO_USER/.local/share/fish/vendor_functions.d
# -*- mode: fish -*-

set -l args $argv
argparse -us err\& -- $argv; or return
set -q _flag_err; and set -l level '--level=err,emerg,crit'

forward (command -sa (path basename (status filename))) $argv
